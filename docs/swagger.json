{
    "swagger": "2.0",
    "info": {
        "description": "Interview project API server.",
        "title": "Pigeon API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/ping": {
            "get": {
                "description": "Writes a heartbeat row to confirm the DB round trip works, then returns pong.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "ping"
                ],
                "summary": "Ping",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.PingResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "handler.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                }
            }
        },
        "handler.PingResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                },
                "time": {
                    "type": "string"
                }
            }
        }
    }
}